# Shared git settings, included from ~/.gitconfig ([include] path = ...).
# Identity and credential helpers stay in ~/.gitconfig, out of this repo.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
[init]
	defaultBranch = main
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[alias]
	fixit = commit --amend --no-edit
	push-f = push --force-with-lease
