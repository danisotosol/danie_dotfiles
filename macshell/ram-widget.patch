+    // RAM in use (MemTotal - MemAvailable, the same figure as `free`'s "used"): GB and % of total.
+    // Polled every 3 s, only while the "ram" bar widget is on, the bar is shown and Game Mode is off.
+    property real ramUsedGb: 0
+    property int ramPct: 0
+    function refreshRam() { if (!ramProc.running) ramProc.running = true; }
+    Process {
+        id: ramProc
+        command: ["awk", "/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{printf \"%.1f %d\", (t-a)/1048576, (t-a)*100/t}", "/proc/meminfo"]
+        stdout: StdioCollector {
+            onStreamFinished: {
+                var p = text.trim().split(" ");
+                root.ramUsedGb = parseFloat(p[0]) || 0;
+                root.ramPct = parseInt(p[1]) || 0;
+            }
+        }
+    }
+    Timer {
+        interval: 3000; repeat: true; triggeredOnStart: true
+        running: root.barWidgetEnabled("ram") && root.barEnabled && !root.gaming
+        onTriggered: root.refreshRam()
+    }
     readonly property var menuTitles: [
